{
  "name": "vigil",
  "version": "0.1.0",
  "private": true,
  "description": "Self-funding Aave liquidation guardian executed through KeeperHub.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "next build",
    "build:agent": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "site:dev": "next dev",
    "site:build": "next build",
    "test": "vitest run",
    "test:watch": "vitest",
    "env:sync": "tsx scripts/sync-local-env.ts",
    "m1:connectivity": "tsx scripts/m1-connectivity.ts",
    "monitor": "tsx scripts/monitor.ts",
    "m4:setup": "tsx scripts/setup-aave-position.ts",
    "m4:rescue": "tsx scripts/execute-rescue.ts",
    "receipt:m4": "tsx scripts/build-m4-receipt.ts",
    "receipt:verify": "tsx scripts/verify-receipt.ts",
    "chaos": "tsx scripts/chaos.ts",
    "workflow:validate": "tsx scripts/validate-workflow.ts",
    "marketplace:publish": "tsx scripts/publish-marketplace.ts",
    "marketplace:prove": "tsx scripts/prove-marketplace.ts",
    "agent-b:demo": "tsx scripts/agent-b-demo.ts",
    "video:assets": "tsx scripts/render-demo-video.ts --assets-only",
    "video:smoke": "tsx scripts/render-demo-video.ts --smoke-test",
    "video:render": "tsx scripts/render-demo-video.ts"
  },
  "dependencies": {
    "@bgd-labs/aave-address-book": "4.44.22",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "dotenv": "^17.2.1",
    "next": "16.2.12",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "viem": "^2.33.1"
  },
  "devDependencies": {
    "@types/node": "^24.1.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  },
  "overrides": {
    "postcss": "8.5.24",
    "sharp": "0.35.3"
  }
}
