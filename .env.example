# Never commit real values. Create .env locally.
KEEPERHUB_API_KEY=kh_replace_locally
KEEPERHUB_BASE_URL=https://app.keeperhub.com

# M1 should send a tiny native Sepolia transfer back to the KeeperHub org wallet.
M1_RECIPIENT_ADDRESS=0x0000000000000000000000000000000000000000
M1_TRANSFER_AMOUNT=0.000001
M1_EXECUTE=false

# M2 read-only monitor. Public RPC is acceptable for a demo; use a dedicated
# provider locally for more reliable polling.
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
AAVE_ACCOUNT_ADDRESS=0x0000000000000000000000000000000000000000
MONITOR_INTERVAL_MS=15000
MONITOR_MAX_BACKOFF_MS=120000
CHAINLINK_MAX_AGE_SECONDS=3600
MONITOR_ONCE=false
