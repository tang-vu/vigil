# Never commit real values. Create .env locally.
KEEPERHUB_API_KEY=kh_replace_locally
KEEPERHUB_BASE_URL=https://app.keeperhub.com

# M1 should send a tiny native Sepolia transfer back to the KeeperHub org wallet.
M1_RECIPIENT_ADDRESS=0x0000000000000000000000000000000000000000
M1_TRANSFER_AMOUNT=0.000001
M1_EXECUTE=false

# M2 read-only monitor. Public RPC is acceptable for a demo; use a dedicated
# provider locally for more reliable polling.
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
AAVE_ACCOUNT_ADDRESS=0x0000000000000000000000000000000000000000
MONITOR_INTERVAL_MS=15000
MONITOR_MAX_BACKOFF_MS=120000
CHAINLINK_MAX_AGE_SECONDS=3600
MONITOR_ONCE=false

# M6 read-only Base proofs and paid Agent B demo. The payment script requires
# both the CLI --pay flag and this explicit guard, then records the confirmed
# Base USDC transfer in ledger/txs.json.
BASE_RPC_URL=https://mainnet.base.org
VIGIL_ALLOW_MAINNET_PAYMENT=false

# MiMo V2.5 TTS/ASR demo-video generation. Create a fresh key locally and
# never paste it into chat or commit it.
MIMO_API_KEY=replace_locally
MIMO_BASE_URL=https://api.xiaomimimo.com/v1

# M4 uses the KeeperHub REST execution API only. Leave false unless deliberately
# creating the documented Sepolia Aave test position.
M4_SETUP_EXECUTE=false
M4_RESCUE_EXECUTE=false
TELEGRAM_CHAT_ID=0
